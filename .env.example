# Copy to .env before running.

# Collaberry's API gateway (Envoy) — the same one the mobile app talks to.
COLLABERRY_GATEWAY_URL=http://localhost:8088

# A dedicated bot account. The orchestrator registers it on first run if it
# doesn't exist yet, then logs in on every subsequent run.
COLLABERRY_BOT_EMAIL=agents@collaberry.dev
COLLABERRY_BOT_PASSWORD=change-me-please-12345

# Which board to work from — matched by name within the bot's first workspace
# that contains it. Set to whatever board holds your real task cards.
COLLABERRY_BOARD_NAME=Collaberry

# 9router — local OpenAI-compatible proxy fanning out to your connected providers.
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=not-needed-for-local-router

# Resilience/performance knobs (defaults shown; all optional).
# Per-request ceiling in seconds - slow combo routes have hit 120s+.
LLM_TIMEOUT_SECONDS=180
# Retries per call on transient failures (0 disables).
LLM_MAX_RETRIES=2
# Output-token caps: short prose (plans) vs whole-file code replies.
LLM_MAX_TOKENS_PLAN=1500
LLM_MAX_TOKENS_CODE=16000
# How many cards `orch plan` works on at once (LLM calls dominate wall clock).
PLAN_CONCURRENCY=3

# Model string per agent role. Prefer pointing these at a 9router Combo id
# (a named Fallback/Round-Robin/Fusion group you configure in the 9router
# dashboard) rather than a specific model - that way a rate limit or outage on
# your primary model degrades gracefully with zero config changes here. A
# single specific model string (e.g. ac-prod/claude-sonnet-4-6) also works if
# you don't want a combo for a given role.
MODEL_HEAD=workflow
MODEL_DEVELOPER=workflow
MODEL_REALTIME_FIXER=workflow
MODEL_MAKEFILE_TESTER=workflow

# Absolute path to the Collaberry repo this orchestrator writes code into.
COLLABERRY_REPO_PATH=D:\uni\Collaberry
